<!-- Interactive Calculator Script -->
<script>
function setAmount(val) {
document.getElementById('customAmount').value = val;
updateImpact(val);
// Highlight active button
const buttons = document.querySelectorAll('.donation-btn');
buttons.forEach(btn => {
if (btn.textContent.includes(val)) {
btn.classList.add('border-rose-600', 'text-rose-600', 'bg-rose-50');
btn.classList.remove('border-slate-200', 'text-slate-700');
} else {
btn.classList.remove('border-rose-600', 'text-rose-600', 'bg-rose-50');
btn.classList.add('border-slate-200', 'text-slate-700');
}
});
}
function updateImpact(amount) {
const impactEl = document.getElementById('impactText');
const num = parseFloat(amount) || 0;
if (num < 50) {
impactEl.textContent = "Helps provide comfort items, toys, and educational books for young cancer patients.";
} else if (num >= 50 && num < 150) {
impactEl.textContent = "Provides medical supplies and support kits for a child undergoing treatment for 1 week.";
} else if (num >= 150 && num < 500) {
impactEl.textContent = "Covers essential laboratory diagnostics and partial prescription medication costs for a patient.";
} else {
impactEl.textContent = "Significantly contributes toward major pediatric oncology care and family accommodation support!";
}
}
</script>
